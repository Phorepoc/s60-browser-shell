// phebrowser_reg.rss -- OURS: the browser frontend's registration (shown in the launcher as "Browser")
#include <appinfo.rh>
#include <phebrowser.rsg>

UID2 KUidAppRegistrationResourceFile
UID3 0xE7016B20

RESOURCE APP_REGISTRATION_INFO
	{
	app_file = "phebrowser";
	localisable_resource_file = "\\resource\\apps\\phebrowser";
	localisable_resource_id = R_PHEBROWSER_LOCALISABLE_APP_INFO;
	// what a web browser opens: the Control Panel's Default applications ("Browse web", the DAS plug-in) lists the applications
	// that declare text/html for the open service, as the 2010 browser (BrowserNG_reg.rss) does -- the same types, at High
	// priority, so with no mapping apparc itself picks this one; the Scheme Handler's http(s) plug-in opens links with the
	// choice (toolchain/shims/schemedisp/HttpHandler.cpp)
	datatype_list =
		{
		DATATYPE { priority = EDataTypePriorityHigh; type = "text/html"; },
		DATATYPE { priority = EDataTypePriorityHigh; type = "application/xhtml+xml"; }
		};
	}
